<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Fanfarr" prefix="Fanfarr - " phx-no-format>{assigns[:page_title]}</.live_title>
    <%!-- SVG first for browsers that support it (crisp at any size, adapts to
          the tab strip); .ico is the fallback for those that do not. --%>
    <%!-- Linked at their plain paths rather than through ~p, which rewrites them
      to the digested filename. Digesting a favicon buys nothing (the URL is
      not on a hot path) and cost us the icon entirely once already: the
      digested name did not match Plug.Static's :only list and every icon
      404'd in prod while working in dev. A version query busts the cache when
      the artwork changes, and Plug.Static treats any query string as a
      versioned request, so these still get immutable caching. --%>
    <link
      rel="icon"
      href={"/favicon.svg?v=#{Fanfarr.Version.asset_version()}"}
      type="image/svg+xml"
    />
    <link
      rel="icon"
      href={"/favicon.ico?v=#{Fanfarr.Version.asset_version()}"}
      sizes="16x16 32x32 48x48"
    />
    <link
      rel="apple-touch-icon"
      href={"/apple-touch-icon.png?v=#{Fanfarr.Version.asset_version()}"}
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.setAttribute("data-theme", systemTheme());
            document.documentElement.setAttribute("data-theme-source", "system");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-source", "user");
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "dark");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });
      })();

      (() => {
        // Like the theme script above, but with one rule that is not a
        // preference: a narrow viewport always starts collapsed.
        //
        // It used to read `stored || (narrow() ? "collapsed" : "expanded")`,
        // so a stored "expanded" -- set on a desktop window, or by one tap on
        // the phone itself, since both share this origin's storage -- beat the
        // narrow default forever after. 208px of a 390px screen is over half
        // the width, given to a nav whose labels are the only thing that
        // padding buys. So the stored choice governs wide viewports only.
        //
        // 767px is where a 208px sidebar starts competing with the page for
        // room; a resized desktop window crosses it the same as a phone does.
        const narrow = () => matchMedia("(max-width: 767px)").matches;

        // Guarded: storage throws rather than returning null in a private
        // window, and an exception here would leave the document with no
        // data-sidebar at all -- which renders as neither state.
        const read = () => {
          try { return localStorage.getItem("phx:sidebar") } catch (_e) { return null }
        };

        const remember = (state) => {
          try { localStorage.setItem("phx:sidebar", state) } catch (_e) {}
        };

        const setSidebar = (state, source) => {
          document.documentElement.setAttribute("data-sidebar", state);
          document.documentElement.setAttribute("data-sidebar-source", source);
        };

        const start = () => {
          const stored = read();

          if (narrow()) {
            setSidebar("collapsed", "system");
          } else {
            setSidebar(stored || "expanded", stored ? "user" : "system");
          }
        };

        start();

        window.addEventListener("storage", (e) => e.key === "phx:sidebar" && start());

        window.addEventListener("phx:toggle-sidebar", () => {
          const next = document.documentElement.getAttribute("data-sidebar") === "collapsed" ? "expanded" : "collapsed";

          // On a phone the toggle is for the moment, not for next time: it
          // opens the nav, you tap a page, and the next load is collapsed
          // again. Persisting it would also silently change what a desktop
          // window opens with, off the same storage key.
          if (!narrow()) { remember(next) }

          setSidebar(next, "user");
        });

        // Crossing the breakpoint re-runs the rule rather than only nudging a
        // "system" state: dragging a window narrow has to collapse a sidebar
        // the operator expanded when there was room for it.
        matchMedia("(max-width: 767px)").addEventListener("change", start);
      })();
    </script>
  </head>
  <body class="bg-background text-foreground">
    {@inner_content}
  </body>
</html>
