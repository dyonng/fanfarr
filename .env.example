# User and group that should own files Fanfarr writes (default 1000).
# Run `id` as the user owning your media to find these. Getting this wrong
# leaves root-owned theme.mp3 files scattered through your library.
PUID=1000
PGID=1000

# Container timezone, so timestamps and schedules read in local time.
# e.g. America/Toronto, Europe/London
TZ=UTC

# Port the dashboard listens on (default 7373).
PORT=7373

# Plex Media Server. Use the host IP if Plex runs on baremetal, or the
# container name if it shares the media-stack network.
PLEX_URL=http://192.168.x.x:32400
# Find yours: https://support.plex.tv/articles/204059436
PLEX_TOKEN=your-plex-token-here

# --- Media paths ---------------------------------------------------------
# Mount each library location separately in docker-compose.yml (/tv1, /tv2,
# /movies1 ...) the way Sonarr and Radarr do, then register those container
# paths as root folders in Settings. Fanfarr matches an item by its directory
# name across those roots, so it does not need the library mounted at Plex's
# own path and this setting can stay empty.
#
# Set it only where a Plex-reported prefix must be translated directly. Pairs of
# plex_prefix:local_prefix separated by ; -- longest match wins:
#   PATH_MAPPINGS=/media/merged-storage/TV:/tv
#   PATH_MAPPINGS=/media/merged-storage/TV:/tv;/media/merged-storage/Movies:/movies
#
# Using mergerfs? Read docs/deployment.md -- bind propagation (:rslave) and the
# pool's create policy both matter.
PATH_MAPPINGS=

# Sends ONLY yt-dlp through a proxy, leaving Plex and ThemerrDB direct. Empty
# means no proxy, which is recommended: YouTube bot-checks datacenter addresses
# far harder than residential ones. See docs/deployment.md.
#   YTDLP_PROXY=http://gluetun:8888
YTDLP_PROXY=

# --- Reverse proxy (optional) -------------------------------------------
# Leave all three unset when reaching Fanfarr directly by IP on your LAN.
# Set these only so generated links point at the public address rather than
# the container. Fanfarr also honours X-Forwarded-* when a proxy sends them.
#
# Hostname the browser uses, e.g. fanfarr.example.com
PHX_HOST=
# http or https, as the browser sees it
URL_SCHEME=http
# Only when hosted under a subpath rather than its own hostname, e.g. /fanfarr
BASE_PATH=

# --- Advanced ------------------------------------------------------------
# Log level: debug | info | warning | error (default: info)
LOG_LEVEL=info

# Where mutable state lives inside the container. Change only if you also
# change the volume mount in docker-compose.yml.
# FANFARR_CONFIG_DIR=/config

# Signs sessions and cookies. Generated once and persisted to
# /config/secret_key_base on first run, so you do not need to set this.
# Set it only to pin the value across rebuilt volumes; changing it just logs
# everyone out.
# SECRET_KEY_BASE=

# Database location. Defaults to /config/fanfarr.db.
# DATABASE_PATH=/config/fanfarr.db
