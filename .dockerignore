# Build output and dependencies are rebuilt inside the image; copying host
# copies in would poison the build with artifacts from a different OS.
_build/
deps/
.elixir_ls/
.lexical/

# Generated assets are rebuilt by `mix assets.deploy`.
priv/static/assets/
priv/static/cache_manifest.json

# Local runtime state must never reach the image. Note this is NOT `/config/`:
# that is the application's own Elixir configuration directory, and excluding it
# strips config.exs and runtime.exs from the build context. The container's
# /config volume is bind-mounted from ./appdata on the host precisely so the two
# cannot be confused.
*.db
*.db-*
/appdata/
secret_key_base

.git/
.github/
.githooks/
docs/
test/
README.md
CHANGELOG.md
*.md
.env
.env.*
!.env.example
docker-compose*.yml
